<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIAppTest.LoginPage"
             Title="Login">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="Please sign in" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
        <Entry x:Name="UsernameEntry" Placeholder="Username" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
        <Button Text="Login" Clicked="OnLoginClicked" />
        <Label x:Name="StatusLabel" TextColor="Red" IsVisible="False" />
    </VerticalStackLayout>
</ContentPage>