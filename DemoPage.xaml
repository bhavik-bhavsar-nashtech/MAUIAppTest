<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIAppTest.DemoPage"
             Title="DemoPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry Text="Empty" TextColor="White"></Entry>
        <Button Text="Click" Clicked="Button_Clicked"></Button>
        <Button Text="Click To Flyout Page" x:Name="btnGotoFlyoutPage" Clicked="btnGotoFlyoutPage_Clicked"></Button>
    </VerticalStackLayout>
</ContentPage>